namespace ExamSystem.Domain;

/// <summary>Final exam: True/False + MCQ. Shows the questions, the answers and the grade.</summary>
public class FinalExam : Exam
{
    public override ExamType Type => ExamType.Final;

    public FinalExam(Subject subject) : base(subject) { }

    public FinalExam(int timeMinutes, Subject subject) : base(timeMinutes, subject) { }

    protected override bool IsQuestionAllowed(Question question) =>
        question is TrueOrFalseQuestion or MCQQuestion;

    public override void ShowExam()
    {
        AskQuestions();

        Output.WriteLine();
        Output.WriteLine("========== Final Exam Result ==========");
        for (int i = 0; i < Questions.Count; i++)
        {
            var q = Questions[i];
            Output.WriteLine($"Q{i + 1}) {q.Header}: {q.Body}");
            Output.WriteLine($"     Your answer: {StudentAnswerText(i)}");
        }

        int grade = CalculateGrade();
        double percent = TotalMark == 0 ? 0 : grade * 100.0 / TotalMark;
        Output.WriteLine();
        Output.WriteLine($"Grade: {grade} / {TotalMark} ({percent:0.#}%)");
    }

    public override object Clone()
    {
        var copy = new FinalExam(TimeMinutes, Subject);
        CloneStateTo(copy);
        return copy;
    }
}
